        pinctrl-0 = <&awinic_gpio_reset>;
        pinctrl-1 = <&awinic_gpio_reset_output_high>;
        pinctrl-2 = <&awinic_gpio_int>;
        pinctrl-names = "awinic_reset_reset", "awinic_reset_active", "awinic_interrupt_active";
        reg = <90>;
        reset-gpio = <&tlmm 38 0>;
        status = "ok";
        vib_effect_id_boundary = <10>;
        vib_effect_max = <197>;
        vib_rtp_time = <20 20 20 20 20 20 20 20 20000 15000 15000 20000 25000 15000 30000 25000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000 20000>;
        wf_0 {
