#include "tuna-audio-mtp.dtsi"
#include "onyx-audio-pinctrl.dtsi"

&lpass_cdc {
    qcom,num-macros = <3>;
};

&wcd9378_tx_slave {
	status = "okay";
};

&wsa_macro {
    status = "disabled";
};

&wsa884x_0221 {
    status = "disabled";
};

&wsa_spkr_en02 {
    status = "disabled";
};

&wsa_spkr_en13 {
    status = "disabled";
};

&cdc_dmic01_gpios {
    status = "disabled";
};

&cdc_dmic23_gpios {
    status = "disabled";
};

&cdc_quin_mi2s_gpios {
    status = "ok";
};

&fm_i2s1_gpios {
    status = "disabled";
};

&lpass_bt_swr {
	status = "ok";
};

&swr0 {
    status = "disabled";

    wsa883x_0221: wsa883x@02170221 {
        compatible = "qcom,wsa883x";
        reg = <0x2 0x2170221>;
        qcom,spkr-sd-n-node = <&wsa_spkr_en02>;
        qcom,lpass-cdc-handle = <&lpass_cdc>;
        cdc-vdd-1p8-supply = <&L15B>;
        qcom,cdc-vdd-1p8-voltage = <1800000 1800000>;
        qcom,cdc-vdd-1p8-current = <20000>;
        qcom,cdc-static-supplies = "cdc-vdd-1p8";
        sound-name-prefix = "SpkrLeft";
        status = "disabled";
    };

    wsa883x_0222: wsa883x@02170222 {
        compatible = "qcom,wsa883x";
        reg = <0x2 0x2170222>;
        qcom,spkr-sd-n-node = <&wsa_spkr_en13>;
        qcom,lpass-cdc-handle = <&lpass_cdc>;
        cdc-vdd-1p8-supply = <&L15B>;
        qcom,cdc-vdd-1p8-voltage = <1800000 1800000>;
        qcom,cdc-vdd-1p8-current = <20000>;
        qcom,cdc-static-supplies = "cdc-vdd-1p8";
        sound-name-prefix = "SpkrRight";
        status = "disabled";
    };
};


&wsa884x_0220 {
	status = "disabled";
};

&soc {
    si_pa_L: si_pa_L {
        channel_num = <0x0>;
        compatible = "si,sia91xx";
        pinctrl-0 = <&sia91xx_gpio_L>;
        pinctrl-names = "si_pa_gpio";
        si,is_digital_pa = <0x1>;
        si,si_pa_disable_pin = <0x0>;
        si,si_pa_reset = <&tlmm 0x7C 0x0>;
        si,si_pa_type = "sia9187";
        spksw-gpio = <&tlmm 0xB7 0x0>;
    };
    si_pa_R: si_pa_R {
        channel_num = <0x1>;
        compatible = "si,sia91xx";
        pinctrl-0 = <&sia91xx_gpio_R>;
        pinctrl-names = "si_pa_gpio";
        si,is_digital_pa = <0x1>;
        si,si_pa_disable_pin = <0x0>;
        si,si_pa_reset = <&tlmm 0x80 0x0>;
        si,si_pa_type = "sia9187";
    };
};

&wcd9378_codec {
	status = "okay";
	qcom,cdc-micbias1-mv = <2750>;
	qcom,cdc-micbias2-mv = <2750>;
	qcom,cdc-micbias3-mv = <2750>;
	qcom,cdc-micbias4-mv = <2750>;
};

&qupv3_se15_i2c {
    status = "ok";
    aw882xx_smartpa@34 {
        aw-cali-mode = "none";
        aw-re-max = <0x7530>;
        aw-re-min = <0xFA0>;
        compatible = "awinic,aw882xx_smartpa";
        dc-flag = <0x0>;
        irq-gpio = <&tlmm 0x7F 0x2008>;
        monitor-mode = "hal_monitor";
        pll-check-disable;
        reg = <0x34>;
        reset-gpio = <&tlmm 0x7C 0x0>;
        sound-channel = <0x0>;
        spksw-gpio = <&tlmm 0xB7 0x0>;
        status = "okay";
        sync-load = <0x1>;
    };
    aw882xx_smartpa@35 {
        aw-cali-mode = "none";
        aw-re-max = <0x7530>;
        aw-re-min = <0xFA0>;
        compatible = "awinic,aw882xx_smartpa";
        dc-flag = <0x0>;
        irq-gpio = <&tlmm 0x81 0x2008>;
        monitor-mode = "hal_monitor";
        pll-check-disable;
        reg = <0x35>;
        reset-gpio = <&tlmm 0x80 0x0>;
        sound-channel = <0x1>;
        status = "okay";
        sync-load = <0x1>;
    };

    sipa_i2c_L: sipa_i2c_L@6C {
        compatible = "si,sia91xx-i2c";
        reg = <0x6C>;
        si,sipa-dev = <&si_pa_L>;
        sound-name-prefix = "SpkrLeft";
    };
    sipa_i2c_R: sipa_i2c_R@6D {
        compatible = "si,sia91xx-i2c";
        reg = <0x6D>;
        si,sipa-dev = <&si_pa_R>;
        sound-name-prefix = "SpkrRight";
    };
};

&qupv3_se5_i2c {
    status = "ok";
    aw8697_haptic@5A {
        aw86927_vib_brk_bst_md = <0>;
        aw86927_vib_bst_vol_default = <95>;
        aw86927_vib_bst_vol_ram = <95>;
